```env
NODE_ENV=development
PORT=4000

# For managed MySQL such as Aiven, use sslaccept=strict in the URL query string.
DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@localhost:3306/gulsaga"

SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

FRONTEND_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SAME_SITE=lax
TRUST_PROXY=0

# Set to "resend" to use the Resend HTTP API for OTP and notification email.
MAIL_PROVIDER=smtp
RESEND_API_KEY=

# SMTP configuration; use a Gmail App Password, not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=REPLACE_WITH_YOUR_SMTP_APP_PASSWORD
MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME=Gulsaga

# Notification recipients
COMPANY_NOTIFICATION_EMAIL=you@example.com
RECRUITMENT_NOTIFICATION_EMAIL=you@example.com

BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
BOOTSTRAP_NAME=Site Administrator

STORAGE_TYPE=local
STORAGE_DIRECTORY=./private-storage

# Required only if using S3-compatible storage
STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
STORAGE_REGION=REPLACE_WITH_REGION
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_SECRET_KEY

MAX_UPLOAD_BYTES=5242880
MAX_EXPERIENCE_UPLOAD_BYTES=104857600

# WhatsApp via OpenWA (https://github.com/rmyndharis/OpenWA) - see src/whatsapp.js
OPENWA_BASE_URL=http://127.0.0.1:2785
# Admin API key printed by OpenWA on first boot (data/.api-key)
OPENWA_API_KEY=
# Session id returned by POST /api/sessions in OpenWA, after you scan the QR code
OPENWA_SESSION_ID=
# Same secret you set when registering the webhook in OpenWA; used to verify X-OpenWA-Signature
OPENWA_WEBHOOK_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_AUTO_REPLY=true
# Pause between bulk messages in ms (1000-60000). Slower is safer for your WhatsApp number.
WHATSAPP_BULK_DELAY_MS=5000

# AI answers on WhatsApp: any OpenAI-compatible API. With no AI_API_KEY and no AI_BASE_URL, AI is off (DB + keyword replies only).
# Free, keyless option: AI_BASE_URL=https://text.pollinations.ai/openai and AI_MODEL=openai-fast (guest text is sent to that service).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# AI_SYSTEM_PROMPT=Optional custom instructions (resort details, policies, tone)
```
# Razorpay payment links inside WhatsApp bookings (leave blank to disable). Advance = % of the stay total.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_ADVANCE_PERCENT=30
# Head-office numbers that receive every WhatsApp booking and payment alert, comma separated.
WHATSAPP_ADMIN_NUMBERS=
